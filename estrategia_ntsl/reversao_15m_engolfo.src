//======================================================================
// Reversao 15m - Engolfo em regiao de topo/fundo
// Plataforma: Profit Pro (Nelogica) - linguagem NTSL
//
// Regra central: TOPO/FUNDO PRIMEIRO; ENGOLFO DEPOIS.
// O engolfo apenas confirma a entrada; quem autoriza o setup e a localizacao.
//
// Dois criterios de regiao, combinaveis via ModoRegiao:
//   0 = SWING   : topo/fundo = extremo recente das ultimas Lookback barras.
//   1 = PERCENT : topo/fundo = preco alcancou a linha de +/- BandaEntrada %.
//   2 = BOTH    : exige os dois criterios ao mesmo tempo (mais restritivo).
//   3 = EITHER  : basta um dos dois.
//
// - Venda no topo : engolfo de baixa numa regiao de topo -> vende a mercado.
// - Compra no fundo: engolfo de alta numa regiao de fundo -> compra a mercado.
// - Veto: engolfo fora da regiao (no meio do caminho) nao gera entrada.
// - Distancia maxima: nao entra se o fechamento ja estiver a mais de
//                     DistMaxRegiao pontos do extremo da regiao.
// - Gestao fixa: Stop Loss 360 pontos / Take Profit 650 pontos.
//
// Linhas de %: a linha de 0% e ancorada no FECHAMENTO DO PREGAO ANTERIOR
// (CloseD(1)), automaticamente, a cada dia. RefPreco > 0 funciona como
// override manual (ex. da imagem: 171035, bandas 0,5% = 171890 e 1% = 172745).
//
// OBS.: Os nomes de procedimentos de ordem/posicao seguem a API padrao de
// estrategias automatizadas do NTSL. Confira/ajuste conforme a versao do seu
// Profit antes de operar em conta real.
//======================================================================

input
  Contratos(1);
  StopLoss(360);
  TakeProfit(650);
  Lookback(20);         // barras para caracterizar topo/fundo (swing)
  Recencia(3);          // o topo/fundo precisa ter ocorrido nas ultimas N barras
  DistMaxRegiao(500);   // distancia maxima (pontos) do extremo da regiao
  ModoRegiao(2);        // 0=swing 1=percent 2=both 3=either (padrao: both)
  RefPreco(0.0);        // 0 = ancora automatica no fech. do pregao anterior
  BandaEntrada(0.5);    // banda minima (%) para caracterizar a regiao

var
  RefAtual     : Float;
  EngolfoBaixa : Boolean;
  EngolfoAlta  : Boolean;
  TopoJanela   : Float;
  FundoJanela  : Float;
  TopoRecente  : Float;
  FundoRecente : Float;
  LinhaTopo    : Float;
  LinhaFundo   : Float;
  SwingTopoOk  : Boolean;
  SwingFundoOk : Boolean;
  PctTopoOk    : Boolean;
  PctFundoOk   : Boolean;
  TopoOk       : Boolean;
  FundoOk      : Boolean;
  TemRef       : Boolean;

begin
  // ---- Engolfo (corpo engolfando corpo) -----------------------------
  EngolfoBaixa := (Close[1] > Open[1]) and (Close < Open) and
                  (Open >= Close[1]) and (Close <= Open[1]);
  EngolfoAlta  := (Close[1] < Open[1]) and (Close > Open) and
                  (Open <= Close[1]) and (Close >= Open[1]);

  // ---- Criterio SWING (extremo recente) -----------------------------
  // O extremo da janela e "recente" quando o extremo das ultimas Recencia
  // barras coincide com o extremo das ultimas Lookback barras.
  TopoJanela   := Highest(High, Lookback);
  FundoJanela  := Lowest(Low,  Lookback);
  TopoRecente  := Highest(High, Recencia);
  FundoRecente := Lowest(Low,  Recencia);
  SwingTopoOk  := TopoRecente >= TopoJanela;
  SwingFundoOk := FundoRecente <= FundoJanela;

  // ---- Criterio PERCENT (linhas de %) -------------------------------
  // Ancora da linha de 0%: fechamento do pregao anterior (CloseD(1)),
  // com RefPreco > 0 como override manual.
  if (RefPreco > 0) then
    RefAtual := RefPreco
  else
    RefAtual := CloseD(1);

  TemRef    := RefAtual > 0;
  LinhaTopo := RefAtual * (1 + BandaEntrada / 100);
  LinhaFundo:= RefAtual * (1 - BandaEntrada / 100);
  PctTopoOk := TemRef and (TopoRecente >= LinhaTopo);
  PctFundoOk:= TemRef and (FundoRecente <= LinhaFundo);

  // ---- Combinacao conforme ModoRegiao -------------------------------
  if (ModoRegiao = 1) and TemRef then begin
    TopoOk  := PctTopoOk;
    FundoOk := PctFundoOk;
  end
  else if (ModoRegiao = 2) and TemRef then begin
    TopoOk  := SwingTopoOk and PctTopoOk;
    FundoOk := SwingFundoOk and PctFundoOk;
  end
  else if (ModoRegiao = 3) and TemRef then begin
    TopoOk  := SwingTopoOk or PctTopoOk;
    FundoOk := SwingFundoOk or PctFundoOk;
  end
  else begin
    // 0 = swing (ou qualquer modo sem RefPreco valido)
    TopoOk  := SwingTopoOk;
    FundoOk := SwingFundoOk;
  end;

  //====================================================================
  // ENTRADAS (somente quando nao ha posicao)
  //====================================================================
  if (not IsBought) and (not IsSold) then
  begin
    if EngolfoBaixa and TopoOk and ((TopoJanela - Close) <= DistMaxRegiao) then
      SellShortAtMarket(Contratos);

    if EngolfoAlta and FundoOk and ((Close - FundoJanela) <= DistMaxRegiao) then
      BuyAtMarket(Contratos);
  end;

  //====================================================================
  // GESTAO (Stop Loss / Take Profit fixos em pontos)
  //====================================================================
  if (IsBought) then
  begin
    if (Low <= (BuyPrice - StopLoss)) then
      SellToCoverAtMarket(Contratos)
    else if (High >= (BuyPrice + TakeProfit)) then
      SellToCoverAtMarket(Contratos);
  end;

  if (IsSold) then
  begin
    if (High >= (SellPrice + StopLoss)) then
      BuyToCoverAtMarket(Contratos)
    else if (Low <= (SellPrice - TakeProfit)) then
      BuyToCoverAtMarket(Contratos);
  end;
end;
